# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.
# In production (Render), set these as real environment variables in the
# dashboard instead; .env is not used there.

# --- Sessions (auth.py) ---
SESSION_SECRET_KEY=dev-only-insecure-key-change-me

# --- Google / Facebook OAuth (auth.py) — optional locally ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# --- Stripe (billing.py) — test mode keys from the Stripe dashboard ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# --- Shared ---
BASE_URL=http://127.0.0.1:8000
