# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.
# In production (Render), set these as real environment variables in the
# dashboard instead; .env is not used there.

# --- Sessions (auth.py) ---
SESSION_SECRET_KEY=dev-only-insecure-key-change-me

# --- Google / Facebook OAuth (auth.py) — optional locally ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# --- Stripe (billing.py) — test mode keys from the Stripe dashboard ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# --- Email sign-in (email_auth.py) ---
# Magic-link sign-in for people with neither Google nor Facebook. Without
# RESEND_API_KEY nothing is sent: locally the link is printed to the server
# log instead, and in production the email option returns a clear error.
# MAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=re_...
# MAIL_FROM=DataExact <hello@dataexact.io>

# --- Admin usage stats (analytics.py) ---
# Comma-separated emails allowed to open /admin/stats, matched against the
# signed-in Google/Facebook account. Leave unset and the route 404s for
# everyone — set it in Render too, or you won't be able to reach it in prod.
ADMIN_EMAILS=you@example.com

# --- Shared ---
BASE_URL=http://127.0.0.1:8000
